{:paths ["src" "resources"]

 ;; data.json reads the table of character references when the code
 ;; compiles, so ClojureScript needs it only at build time. Clojure 1.11 is
 ;; the floor, and the tests run on it unless an alias says otherwise.
 :deps  {org.clojure/clojure   {:mvn/version "1.11.4"}
         org.clojure/data.json {:mvn/version "2.5.2"}}

 :aliases
 {;; clojure -X:test
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}

  ;; clojure -M:cljs compile test  (the tests in Node)
  :cljs {:extra-paths   ["test"]
         :override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}
         :extra-deps    {thheller/shadow-cljs {:mvn/version "3.5.3"}}
         :main-opts     ["-m" "shadow.cljs.devtools.cli"]}

  ;; clojure -X:bench  (after npm install, for Node and the bundles).
  ;; clj-tagsoup asks for a data.xml that doesn't compile on Clojure 1.9+.
  :bench {:extra-paths   ["bench"]
          :override-deps {org.clojure/clojure  {:mvn/version "1.12.5"}
                          org.clojure/data.xml {:mvn/version "0.0.8"}}
          :extra-deps
          {thheller/shadow-cljs            {:mvn/version "3.5.3"}
           org.clj-commons/hickory         {:mvn/version "0.7.7"}
           clj-tagsoup/clj-tagsoup         {:mvn/version "0.3.0"}
           org.jsoup/jsoup                 {:mvn/version "1.23.2"}
           hiccup/hiccup                   {:mvn/version "2.0.0"}
           io.github.escherize/huff        {:mvn/version "0.2.21"}
           no.cjohansen/replicant          {:mvn/version "2026.07.1"}
           io.github.furstenheim/copy_down {:mvn/version "1.1"}
           com.vladsch.flexmark/flexmark-html2md-converter
           {:mvn/version "0.64.8"}
           com.googlecode.owasp-java-html-sanitizer/owasp-java-html-sanitizer
           {:mvn/version "20260924.2"}}
          :exec-fn       dk.simongray.html-pieces.bench/run}

  ;; clojure -T:build jar | install | deploy  (see build.clj)
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                       slipset/deps-deploy            {:mvn/version "0.2.5"}}
          :ns-default build}}}
